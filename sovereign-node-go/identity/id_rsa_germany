<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sovereign V10.0 | Autonomous Bridge</title>
    <style>
        :root { --bg: #010409; --panel: #0d1117; --accent: #8957e5; --green: #238636; --text: #c9d1d9; --border: #30363d; }
        body { background: var(--bg); color: var(--text); font-family: 'JetBrains Mono', monospace; margin: 0; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .header { background: var(--panel); border-bottom: 1px solid var(--border); padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: bold; }
        .lock { color: var(--green); }
        .dashboard { display: grid; grid-template-rows: 1fr 1fr; flex: 1; overflow: hidden; }
        
        .code-view { background: var(--bg); color: #39ff14; padding: 15px; font-size: 12px; overflow-y: auto; border-bottom: 1px solid var(--border); }
        .code-view pre { margin: 0; white-space: pre-wrap; word-wrap: break-word; }
        
        .bridge-view { display: flex; flex-direction: column; background: #000; }
        .terminal { flex: 1; padding: 15px; font-size: 11px; color: #58a6ff; overflow-y: auto; line-height: 1.4; }
        .input-zone { display: flex; padding: 10px; background: var(--panel); border-top: 1px solid var(--border); gap: 8px; }
        input[type="text"] { flex: 1; background: #010409; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 12px; outline: none; }
        button { background: var(--accent); color: #fff; border: none; padding: 0 15px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 11px; }
    </style>
</head>
<body>
    <div class="header">
        <div>V10.0 SINGULARITY | S25_FE</div>
        <div class="lock">ASSET LOCK: $814.68</div>
    </div>
    
    <div class="dashboard">
        <div class="code-view">
            <div style="color:var(--accent); margin-bottom:10px;">// SYSTEM STATUS & TRADING TICK</div>
            <pre id="sys-status">Initializing Forensic Hub Sync...
Waiting for Bridge hook...</pre>
        </div>
        
        <div class="bridge-view">
            <div class="terminal" id="term">
                [BRIDGE] Autonomous Gemini Hooks Active.<br>
                [BRIDGE] Command execution routed to Termux bash.<br>
                Ready for input...
            </div>
            <div class="input-zone">
                <input type="text" id="cmd" placeholder="Enter bash command or system directive..." onkeydown="if(event.key==='Enter') executeBridge()">
                <button onclick="executeBridge()">EXECUTE</button>
            </div>
        </div>
    </div>

    <script>
        async function executeBridge() {
            const input = document.getElementById('cmd');
            const term = document.getElementById('term');
            const val = input.value;
            if (!val) return;
            
            term.innerHTML += `<br><span style="color:#fff;">$ ${val}</span><br><span style="color:#8b949e;">Executing via local hook...</span>`;
            input.value = '';
            term.scrollTop = term.scrollHeight;

            try {
                const response = await fetch('/api/bridge?cmd=' + encodeURIComponent(val));
                const text = await response.text();
                term.innerHTML += `<br>${text.replace(/\n/g, '<br>')}`;
            } catch (err) {
                term.innerHTML += `<br><span style="color:#da3633;">Hook Error: ${err}</span>`;
            }
            term.scrollTop = term.scrollHeight;
        }

        
        setInterval(async () => {
            const res = await fetch('/api/status');
            const text = await res.text();
            document.getElementById('sys-status').innerText = text;
        }, 5000);
    </script>
</body>
</html>
