{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mh/**",
        "destination": "/mh/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
