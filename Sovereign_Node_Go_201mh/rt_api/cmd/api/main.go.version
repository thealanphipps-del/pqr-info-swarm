package main

import (
"github.com/gin-gonic/gin"
"net/http"
"os"
)

type Ticket struct {
ID      string `json:"id"`
Status  string `json:"status"`
Subject string `json:"subject"`
}

func main() {
r := gin.Default()

// REST 2.0 TICKETING ENDPOINT
r.POST("/api/v2/tickets", func(c *gin.Context) {
var t Ticket
if err := c.ShouldBindJSON(&t); err != nil {
c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
return
}
// LOGIC: Pushing to 39.mh would happen here via lib/pq
c.JSON(http.StatusOK, gin.H{"status": "queued", "ticket": t})
})

port := os.Getenv("PORT")
if port == "" { port = "8080" }
r.Run(":" + port)
}
